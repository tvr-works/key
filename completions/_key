#compdef key

__key_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__key_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __key_complete "${completions[@]:0:-1}"
    fi
}

__key_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_key() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar arg_specs=(
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'init:Create a new vault and use it on this Mac.'
            'share:Add another Mac to an existing vault or manage access.'
            'add:Save a secret or authenticator setup secret.'
            'edit:Replace a saved secret or authenticator setup secret.'
            'get:Print a secret or current one-time code.'
            'copy:Copy a secret or current one-time code to the clipboard.'
            'list:List saved entry names.'
            'duplicate:Copy an entry under another name.'
            'rename:Change an entry'\''s name.'
            'remove:Delete an entry after confirmation.'
            'status:Check vault health without editing its contents.'
            'conflict:Review conflicting entries and choose what to keep.'
            'config:Show or change this Mac'\''s vault settings.'
            'migrate:Check or migrate a vault in the older format.'
            'recovery:Set up hardware recovery or recover a vault.'
            'unlock:Unlock the vault before running other commands.'
            'lock:Lock the vault on this Mac.'
            'version:Show the installed CLI'\''s version and build number.'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        init|share|add|edit|get|copy|list|duplicate|rename|remove|status|conflict|config|migrate|recovery|unlock|lock|version|help)
            "_key_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

